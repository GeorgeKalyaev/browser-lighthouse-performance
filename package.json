{
  "name": "browser-lighthouse-performance",
  "version": "1.1.0",
  "description": "Browser performance probe: Playwright + Lighthouse → InfluxDB 1.8 / Grafana (optional Jenkins + kind)",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "browser:install": "playwright install chromium",
    "browser:performance:check": "tsx src/check.ts",
    "browser:performance": "tsx src/index.ts",
    "browser:performance:dist": "node dist/index.js",
    "browser:performance:check:dist": "node dist/check.js",
    "bootstrap": "powershell -ExecutionPolicy Bypass -File ./scripts/bootstrap.ps1",
    "local:up": "powershell -ExecutionPolicy Bypass -File ./scripts/start-local.ps1",
    "local:jenkins": "powershell -ExecutionPolicy Bypass -File ./scripts/start-jenkins.ps1",
    "local:git": "powershell -ExecutionPolicy Bypass -File ./scripts/setup-git-scm.ps1",
    "local:nexus": "powershell -ExecutionPolicy Bypass -File ./scripts/setup-nexus.ps1",
    "local:k8s": "powershell -ExecutionPolicy Bypass -File ./scripts/setup-k8s.ps1",
    "local:cleanup": "powershell -ExecutionPolicy Bypass -File ./scripts/cleanup-local.ps1",
    "test": "tsx --test tests/**/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "lighthouse": "^12.4.0",
    "playwright": "^1.50.1"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
