# Application
TEST_STAND=http://127.0.0.1:1080/
PERFORMANCE_URLS_PROFILE=webtoursUrls

# Runner
RUN_TIME=60
PACING=5
PERF_REQUEST_TIMEOUT=60
CACHE_MODE=cold

# Browser (optional; empty = Playwright Chromium)
CHROME_PATH=

# Auth — logical token names map to these env vars (never commit real values)
USER_TOKEN=
ADMIN_TOKEN=
# Optional override for public pages (default: anonymous)
ANONYMOUS_TOKEN=

# Auth strategy for the target SPA:
#   bearer-header  — Authorization: Bearer <token> on all requests
#   local-storage  — write token into localStorage before Lighthouse navigation
#   session-storage — same for sessionStorage
#   cookie         — set cookie AUTH_COOKIE_NAME=<token>
AUTH_STRATEGY=bearer-header
AUTH_STORAGE_KEY=accessToken
AUTH_COOKIE_NAME=access_token

# InfluxDB 1.8
INFLUX_ENABLED=true
INFLUX_URL=http://127.0.0.1:8086
INFLUX_DATABASE=performance
INFLUX_USERNAME=
INFLUX_PASSWORD=
INFLUX_MEASUREMENT=browser_performance

# Optional — shared with JMeter in Jenkins later
RUN_ID=
